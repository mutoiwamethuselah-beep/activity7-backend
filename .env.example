# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://postgres:password@localhost:5432/maintenance
# Set to true for hosted databases (Render, Neon, Supabase). Leave false locally.
DATABASE_SSL=false
# Allowed frontend origins, comma separated, no path and no final slash.
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PORT=3000
